generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  username     String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  rooms        Room[]
}

model Room {
  id              String   @id @default(uuid())
  hostId          String
  roomCode        String   @unique
  title           String
  durationMinutes Int
  expiresAt       DateTime
  isAccepting     Boolean  @default(true)
  createdAt       DateTime @default(now())

  // Relations
  host     User      @relation(fields: [hostId], references: [id], onDelete: Cascade)
  messages Message[]
}

model Message {
  id        String   @id @default(uuid())
  roomId    String
  content   String   @db.VarChar(300)
  status    String   @default("accepted") // "accepted", "rejected", "pinned"
  createdAt DateTime @default(now())

  // Relations
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
}
