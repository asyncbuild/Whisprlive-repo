generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(uuid())
  username     String
  email        String    @unique
  passwordHash String
  plan         String   @default("SOLO") // SOLO, HOST, STUDIO
  roomPasses   Int      @default(0)
  createdAt    DateTime  @default(now())
  rooms        Room[]
  collaborations RoomCollaborator[]
  pollTemplates PollTemplate[]
  payments     Payment[]
}

model Room {
  id              String    @id @default(uuid())
  hostId          String
  roomCode        String    @unique
  title           String
  durationMinutes Int
  startsAt        DateTime @default(now())
  expiresAt       DateTime
  isAccepting     Boolean   @default(true)
  showPublicFeed  Boolean   @default(true) // Host toggle: whether approved questions are visible to audience
  activityType    String    @default("ALL") // "ALL" | "POLL" | "WORD_CLOUD" | "QA"
  isPassUsed      Boolean   @default(false)
  createdAt       DateTime  @default(now())
  closedAt        DateTime?

  // Relations
  host            User      @relation(fields: [hostId], references: [id], onDelete: Cascade)
  messages        Message[]
  polls           Poll[]
  collaborators   RoomCollaborator[]
}

model Message {
  id          String   @id @default(uuid())
  roomId      String
  content     String   @db.VarChar(300)
  status      String   @default("accepted") // "accepted", "rejected", "pinned"
  upvotes     Int      @default(0)
  isAnswered  Boolean  @default(false)
  isPinned    Boolean  @default(false)
  hostReply   String?

  // Tracking Metadata
  device      String?  // e.g. "Mobile (Android 11)"
  deviceModel String?  // e.g. "Realme RMX3085" or "Samsung SM-S918B"
  location    String?  // e.g. "Mumbai, India"
  ipAddress   String?  // e.g. "49.37.142.18"

  createdAt   DateTime @default(now())

  // Relations
  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model Poll {
  id          String         @id @default(uuid())
  roomId      String
  question    String
  type        String         @default("CHOICE") // "CHOICE", "WORD_CLOUD"
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())

  // Relations
  room        Room           @relation(fields: [roomId], references: [id], onDelete: Cascade)
  options     PollOption[]
  responses   PollResponse[]
}

model PollOption {
  id        String         @id @default(uuid())
  pollId    String
  text      String
  votes     Int            @default(0)

  // Relations
  poll      Poll           @relation(fields: [pollId], references: [id], onDelete: Cascade)
  responses PollResponse[]
}

model PollResponse {
  id        String       @id @default(uuid())
  pollId    String
  optionId  String?
  word      String?      // for WORD_CLOUD response
  voterId   String       // anonymous client fingerprint / ID
  createdAt DateTime     @default(now())

  // Relations
  poll      Poll         @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option    PollOption?  @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([pollId, voterId])
}

model PlanWaitlist {
  id        String   @id @default(uuid())
  email     String
  plan      String   // "HOST", "STUDIO"
  createdAt DateTime @default(now())

  @@unique([email, plan])
}

model Feedback {
  id        String   @id @default(uuid())
  category  String   @default("suggestion") // "suggestion", "bug", "general"
  message   String
  email     String?
  createdAt DateTime @default(now())
}

model PollTemplate {
  id        String   @id @default(uuid())
  userId    String
  title     String?  // Optional label/topic tag
  question  String
  type      String   @default("CHOICE") // "CHOICE" | "WORD_CLOUD"
  options   String[] // Array of option strings
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RoomCollaborator {
  id        String   @id @default(uuid())
  roomId    String
  userId    String
  role      String   @default("MODERATOR")
  createdAt DateTime @default(now())

  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId])
}

model Payment {
  id                String   @id @default(uuid())
  userId            String
  razorpayOrderId   String
  razorpayPaymentId String   @unique
  plan              String   // "ROOM_PASS", "HOST", etc.
  amount            Int      @default(0)
  createdAt         DateTime @default(now())

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}


